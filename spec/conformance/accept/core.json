[
  {
    "schema": "aether.core-transition/k0-0.4",
    "id": "accept.move_once",
    "rules": ["K0-PLACE-002", "CONF-004"],
    "target": "k0-reference-64",
    "initial": {
      "places": {
        "x": { "state": "initialized", "value": { "kind": "int", "type": "u8", "value": 7 } }
