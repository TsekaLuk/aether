(* Aether K0 surface grammar, draft v0.4. EBNF metasymbols are not tokens. *)
(* Whitespace and comments separate tokens and are otherwise omitted here. *)

source_file       = module_decl, item* ;
module_decl       = "module", module_path, ";" ;
module_path       = IDENT, (".", IDENT)* ;

item              = visibility?, (const_decl | struct_decl | enum_decl | fn_decl) ;
visibility        = "pub" ;
const_decl        = "const", IDENT, ":", type, "=", contract_expression, ";" ;

struct_decl       = "struct", IDENT, "{", struct_member*, "}" ;
struct_member     = field_decl | invariant_clause ;
field_decl        = visibility?, IDENT, ":", type, "," ;

enum_decl         = "enum", IDENT, "{", enum_member*, "}" ;
enum_member       = variant_decl | invariant_clause ;
variant_decl      = IDENT, variant_payload?, "," ;
variant_payload   = "(", type_list?, ")" |
                    "{", field_decl*, "}" ;

fn_decl           = "fn", IDENT, "(", param_list?, ")", return_type?,
                    function_contract*, block ;
param_list        = param, (",", param)*, ","? ;
param             = IDENT, ":", type ;
return_type       = "->", type ;
function_contract = ("requires" | "ensures"), contract_id,
                    ":", contract_expression, ";" ;
invariant_clause  = "invariant", contract_id,
                    ":", contract_expression, ";" ;
contract_id       = IDENT, (".", IDENT)* ;

type              = primitive_type | path_type | tuple_type | array_type |
                    slice_type | reference_type | builtin_type ;
primitive_type    = "bool" | "unit" |
                    "u8" | "u16" | "u32" | "u64" |
                    "i8" | "i16" | "i32" | "i64" |
                    "usize" | "isize" ;
path_type         = symbol_path ;
tuple_type        = "(", type_list?, ")" ;
type_list         = type, (",", type)*, ","? ;
array_type        = "[", type, ";", integer_literal, "]" ;
slice_type        = "[", type, "]" ;
reference_type    = "&", LIFETIME?, "mut"?, type ;
builtin_type      = "Own", "<", type, ",", brand_path, ">" |
                    "Allocator", "<", brand_path, ">" |
                    "Result", "<", type, ",", type, ">" ;
brand_path        = symbol_path ;

block             = "{", statement*, tail_expression?, "}" ;
statement         = let_statement | assignment | expression_statement |
                    return_statement | while_statement | loop_statement |
                    break_statement | continue_statement ;
let_statement     = "let", "mut"?, IDENT, type_annotation?,
                    "=", expression, ";" ;
type_annotation   = ":", type ;
assignment        = place_expression, "=", expression, ";" ;
expression_statement = expression, ";" ;
return_statement  = "return", expression?, ";" ;
while_statement   = "while", expression, block ;
loop_statement    = "loop", block ;
break_statement   = "break", ";" ;
continue_statement = "continue", ";" ;
tail_expression   = expression ;

expression        = logical_or ;
logical_or        = logical_and, ("||", logical_and)* ;
logical_and       = equality, ("&&", equality)* ;
equality          = comparison, (("==" | "!="), comparison)* ;
comparison        = additive, (("<" | "<=" | ">" | ">="), additive)* ;
additive          = multiplicative, (("+" | "-"), multiplicative)* ;
multiplicative    = unary, (("*" | "/" | "%"), unary)* ;
unary             = unary_operator*, postfix ;
unary_operator    = "!" | "-" | "move" | "*" | borrow_operator ;
borrow_operator   = "&", "mut"? ;
postfix           = primary, (call_suffix | field_suffix | index_suffix)* ;
call_suffix       = "(", argument_list?, ")" ;
argument_list     = expression, (",", expression)*, ","? ;
field_suffix      = ".", IDENT ;
index_suffix      = "[", expression, "]" ;

primary           = literal | path_expression | tuple_expression |
                    array_expression | record_expression | block |
                    if_expression | match_expression |
                    "(", expression, ")" ;
path_expression   = symbol_path ;
symbol_path       = IDENT, ("::", IDENT)* ;
place_expression  = place_base, (field_suffix | index_suffix)* ;
place_base        = path_expression | "*", unary ;

tuple_expression  = "(", (expression, ",", argument_list?)?, ")" ;
array_expression  = "[", argument_list?, "]" ;
record_expression = "init", symbol_path, "{", field_initializer*, "}" ;
field_initializer = IDENT, ":", expression, "," ;

if_expression     = "if", expression, block,
                    ("else", (block | if_expression))? ;
match_expression  = "match", expression, "{", match_arm+, "}" ;
match_arm         = pattern, "=>", expression, "," ;
pattern           = "_" | literal | binding_pattern | path_pattern |
                    tuple_pattern | variant_tuple_pattern |
                    variant_record_pattern ;
binding_pattern   = IDENT ;
path_pattern      = IDENT, "::", IDENT, ("::", IDENT)* ;
tuple_pattern     = "(", pattern_list?, ")" ;
variant_tuple_pattern = path_pattern, "(", pattern_list?, ")" ;
variant_record_pattern = path_pattern, "{", field_pattern*, "}" ;
field_pattern     = IDENT, ":", pattern, "," ;
pattern_list      = pattern, (",", pattern)*, ","? ;

(* Contract expressions are pure and syntactically total. Calls, indexing, *)
(* division, remainder, borrow, move, dereference, and control flow are absent. *)
contract_expression = contract_or ;
contract_or       = contract_and, ("||", contract_and)* ;
contract_and      = contract_equality, ("&&", contract_equality)* ;
contract_equality = contract_comparison,
                    (("==" | "!="), contract_comparison)* ;
contract_comparison = contract_additive,
                      (("<" | "<=" | ">" | ">="), contract_additive)* ;
contract_additive = contract_multiplicative,
                    (("+" | "-"), contract_multiplicative)* ;
contract_multiplicative = contract_unary, ("*", contract_unary)* ;
contract_unary    = ("!" | "-")*, contract_primary ;
contract_primary  = literal | contract_path |
                    "(", contract_expression, ")" ;
contract_path     = symbol_path, (".", IDENT)* ;

literal           = integer_literal | "true" | "false" ;
integer_literal   = DEC_INTEGER | BIN_INTEGER | OCT_INTEGER | HEX_INTEGER ;
