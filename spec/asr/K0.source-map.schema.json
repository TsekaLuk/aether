{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.invalid/spec/0.4/asr/K0.source-map.schema.json",
  "title": "Aether K0 resolved ASR source map",
  "type": "object",
  "required": ["schema", "language_version", "asr_schema", "asr_hash", "package_id", "sources", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aether.source-map/k0-0.4" },
    "language_version": { "const": "0.4.0-draft" },
    "asr_schema": { "const": "aether.asr/k0-0.4" },
    "asr_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "package_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,62}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "source_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.ae$"
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "byte_length"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/source_path" },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 0 }
      }
    },
    "entry": {
      "type": "object",
      "required": ["pointer", "source", "start", "end", "origin"],
      "additionalProperties": false,
      "properties": {
        "pointer": { "type": "string", "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$" },
        "source": { "$ref": "#/$defs/source_path" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "origin": { "enum": ["source", "synthetic"] }
      }
    }
  }
}
