{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.invalid/spec/0.4/package.schema.json",
  "title": "Aether K0 package manifest",
  "type": "object",
  "required": ["schema", "language_version", "package_id", "target", "modules", "entry"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aether.package/k0-0.4" },
    "language_version": { "const": "0.4.0-draft" },
    "package_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,62}$" },
    "target": { "const": "k0-reference-64" },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.ae$"
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+$"
    }
  }
}
